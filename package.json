{
  "name": "dsh-prompt-forge",
  "version": "0.1.1",
  "description": "用文件定制 DSH 的系统提示词、运行时上下文与每轮提醒。",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "prompt"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liu-zhengdong/dsh-prompt-forge.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
